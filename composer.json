{
    "name": "koh/sylius-llms-txt",
    "description": "Serves /llms.txt and /llms-full.txt for Sylius, generated from the channel catalogue and content.",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "llms.txt",
        "llm",
        "ai",
        "agent",
        "discovery"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source/sylius-agent-ready",
    "support": {
        "issues": "https://github.com/ohartwig/sylius-llms-txt/issues",
        "source": "https://github.com/ohartwig/sylius-llms-txt",
        "security": "https://github.com/ohartwig/sylius-llms-txt/blob/main/SECURITY.md"
    },
    "require": {
        "koh/sylius-agent-contracts": "^1.3.1",
        "ext-mbstring": "*",
        "php": "^8.3",
        "psr/cache": "^3.0.0",
        "sylius/sylius": "^2.2.9 || ^2.3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "^11.5.57",
        "symfony/cache": "^7.4.21"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusLlmsTxt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusLlmsTxt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
